# Only for the local Vite development server. Never use this as the production password.
VITE_ADMIN_DEV_PASSWORD=change-this-local-password

# Add these two variables in Vercel Project Settings -> Environment Variables.
ADMIN_PASSWORD=change-this-production-password
ADMIN_SESSION_SECRET=generate-a-random-secret-with-at-least-32-characters

# Vercel adds Blob authentication automatically when the store is connected.
# New stores use OIDC (BLOB_STORE_ID); legacy stores use BLOB_READ_WRITE_TOKEN.
